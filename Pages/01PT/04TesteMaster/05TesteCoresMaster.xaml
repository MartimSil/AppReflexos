<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.TesteCoresMaster"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <Label Text="MASTER: TESTE 5/5" HorizontalOptions="Center" TextColor="Gray" FontSize="14"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="20">
            <Label x:Name="lblRegrasAtivas" Text="Regras: 0/10" TextColor="Gray" FontSize="18" HorizontalTextAlignment="Center"/>
            <Label x:Name="lblDescricaoRegra" Text="" TextColor="Gold" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            <Label x:Name="lblFeedback" Text="Foca-te!" TextColor="White" FontSize="26" HorizontalTextAlignment="Center"/>

            <Border x:Name="AlvoVisual" WidthRequest="200" HeightRequest="200" BackgroundColor="Transparent" StrokeThickness="4" Stroke="White" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle x:Name="FormaAlvo" CornerRadius="0"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlvoTapped" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>

        <Button x:Name="btnAcao" Grid.Row="2" Text="INICIAR" Clicked="OnActionButtonClicked" HeightRequest="70" CornerRadius="35" BackgroundColor="#2ECC71" FontSize="22" FontAttributes="Bold"/>
    </Grid>
</ContentPage>