<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.TesteReacaoMaster"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="20">
        <Label Text="MASTER: TESTE 1/5" HorizontalOptions="Center" TextColor="Gray" FontSize="14"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="25">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Border x:Name="Luz1" WidthRequest="60" HeightRequest="80" BackgroundColor="#444444"/>
                <Border x:Name="Luz2" WidthRequest="60" HeightRequest="80" BackgroundColor="#444444"/>
                <Border x:Name="Luz3" WidthRequest="60" HeightRequest="80" BackgroundColor="#444444"/>
                <Border x:Name="Luz4" WidthRequest="60" HeightRequest="80" BackgroundColor="#444444"/>
                <Border x:Name="Luz5" WidthRequest="60" HeightRequest="80" BackgroundColor="#444444"/>
            </HorizontalStackLayout>

            <Label x:Name="lblResultado" Text="0 ms" TextColor="White" FontSize="60" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

            <Button x:Name="btnAcao" Text="Iniciar" Clicked="OnActionButtonClicked" WidthRequest="220" HeightRequest="220" CornerRadius="110" BackgroundColor="#2ECC71" FontSize="26" FontAttributes="Bold"/>
        </VerticalStackLayout>

        <Button x:Name="btnProximo" Grid.Row="2" Text="PRÓXIMO TESTE" IsVisible="False" Clicked="OnProximoClicked" BackgroundColor="#512BD4" HeightRequest="60" CornerRadius="30"/>
    </Grid>
</ContentPage>mas eu 