<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.TesteEscolherMaster"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <Label Text="MASTER: TESTE 4/5" HorizontalOptions="Center" TextColor="Gray" FontSize="14"/>

        <VerticalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Center">
            <Label x:Name="lblTimer" Text="Tempo: 1.5s" FontSize="20" HorizontalOptions="Center" TextColor="Orange" FontAttributes="Bold" />
            <Label x:Name="lblPergunta" Text="Pronto?" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="150,150" Padding="10" ColumnSpacing="10" RowSpacing="10">
                <Button x:Name="btn0" Grid.Row="0" Grid.Column="0" Clicked="OnCorClicked" CornerRadius="15"/>
                <Button x:Name="btn1" Grid.Row="0" Grid.Column="1" Clicked="OnCorClicked" CornerRadius="15"/>
                <Button x:Name="btn2" Grid.Row="1" Grid.Column="0" Clicked="OnCorClicked" CornerRadius="15"/>
                <Button x:Name="btn3" Grid.Row="1" Grid.Column="1" Clicked="OnCorClicked" CornerRadius="15"/>
            </Grid>
        </VerticalStackLayout>

        <ContentView x:Name="OverlayStart" Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="True">
            <Button Text="COMEÇAR" Clicked="OnStartClicked" WidthRequest="200" HeightRequest="80" CornerRadius="40" BackgroundColor="#2ECC71" FontSize="24"/>
        </ContentView>
    </Grid>
</ContentPage>