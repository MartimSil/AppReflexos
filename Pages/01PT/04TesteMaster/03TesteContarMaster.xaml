<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.TesteContarMaster"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        <Label Text="MASTER: TESTE 3/5" HorizontalOptions="Center" TextColor="Gray" FontSize="14"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="20">
            <Label x:Name="lblInstrucao" 
                   Text="Para o cronómetro aos 10 segundos!"
                   TextColor="#26FFFF"
                   HorizontalOptions="Center" 
                   FontSize="22"
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="lblTempo" 
                   Text="00:00.00"
                   TextColor="White"
                   FontSize="70" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button x:Name="btnIniciarParar" 
                    Text="INICIAR" 
                    Clicked="OnIniciarResetClicked" 
                    BackgroundColor="Green" 
                    WidthRequest="220" 
                    HeightRequest="80"
                    CornerRadius="40"
                    FontSize="24"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>