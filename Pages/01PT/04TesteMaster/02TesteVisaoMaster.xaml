<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.TesteVisaoMaster"
             Shell.NavBarIsVisible="False">
    
    <AbsoluteLayout Padding="20">
        <Label x:Name="PalavraLabel" FontSize="50" FontAttributes="Bold" AbsoluteLayout.LayoutBounds="0.5, 0.4, 300, 100" AbsoluteLayout.LayoutFlags="PositionProportional" HorizontalTextAlignment="Center" TextColor="White"/>

        <VerticalStackLayout x:Name="LayoutBotoes" IsVisible="False" Spacing="20" AbsoluteLayout.LayoutBounds="0.5, 0.8, 1, -1" AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional">
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="SIM" Clicked="OnSimClicked" WidthRequest="120" BackgroundColor="#2ECC71"/>
                <Button Text="NÃO" Clicked="OnNaoClicked" WidthRequest="120" BackgroundColor="#EF4444"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Button x:Name="BtnProxima" Text="Começar" Clicked="OnGerarPalavraClicked" AbsoluteLayout.LayoutBounds="0.5, 0.7, 200, 60" AbsoluteLayout.LayoutFlags="PositionProportional"/>
        <Button x:Name="btnProximoMaster" Text="PRÓXIMO TESTE" IsVisible="False" Clicked="OnProximoClicked" BackgroundColor="#512BD4" AbsoluteLayout.LayoutBounds="0.5, 0.9, 250, 60" AbsoluteLayout.LayoutFlags="PositionProportional"/>
    </AbsoluteLayout>
</ContentPage>