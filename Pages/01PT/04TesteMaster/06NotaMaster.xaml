<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.TesteMaster.NotaMaster"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout VerticalOptions="Center" Spacing="40" Padding="30">
        <Label Text="PONTUAÇÃO TOTAL MASTER" 
               TextColor="Gray" 
               HorizontalOptions="Center" 
               FontSize="20" 
               FontAttributes="Bold"/>

        <Label x:Name="lblTotal" 
               TextColor="#512BD4" 
               FontSize="110" 
               FontAttributes="Bold" 
               HorizontalOptions="Center"/>

        <VerticalStackLayout Spacing="10">
            <Label Text="Máximo Possível: 100 pts" 
                   TextColor="DimGray" 
                   HorizontalOptions="Center" 
                   FontSize="14"/>

            <Button Text="CONCLUIR E SAIR" 
                    Clicked="OnFinalizar" 
                    BackgroundColor="#2ECC71" 
                    TextColor="White"
                    HeightRequest="80" 
                    CornerRadius="40" 
                    FontSize="22" 
                    FontAttributes="Bold">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="15" Opacity="0.5"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>