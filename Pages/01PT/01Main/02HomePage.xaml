<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.Main.HomePage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Button Text="Teste de Reação" Clicked="OnTesteReacaoClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
            <Button Text="Teste de Visão" Clicked="OnTesteVisaoClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
            <Button Text="Teste de Contagem Cegas" Clicked="OnTesteContarClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
            <Button Text="Teste de Escolha" Clicked="OnTesteEscolherClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
            <Button Text="Teste de Cores" Clicked="OnTesteCoresClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
            <!--<Button Text="Teste Master" Clicked="OnTesteReacaoMasterClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>-->
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Casa" BackgroundColor="DeepSkyBlue" TextColor="White" Clicked="OnMainPageClicked" />
            <Button Text="Notas" BackgroundColor="DarkViolet" Clicked="OnHomePageNotasClicked"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>