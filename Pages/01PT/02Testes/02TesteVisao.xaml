<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.Testes.TesteVisao">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Text="?"
                Clicked="OnHelpButtonClicked"
                BackgroundColor="Blue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="20"
                CornerRadius="25"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="End"
                VerticalOptions="Start" />

        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center">

            <Label x:Name="PontuacaoLabel" 
                   Text="Pontos: 0 | Palavra: 0/10" 
                   HorizontalOptions="Center" 
                   FontSize="16" 
                   TextColor="Gray" />

            <Label x:Name="PalavraLabel" 
                   FontSize="50" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold" 
                   HeightRequest="120" 
                   VerticalTextAlignment="Center" />

            <VerticalStackLayout x:Name="LayoutBotoes" IsVisible="False" Spacing="15">
                
                <Label Text="A palavra estava correta?" 
                       HorizontalOptions="Center" />
                
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    
                    <Button Text="SIM" 
                            Clicked="OnSimClicked" 
                            BackgroundColor="Green" 
                            WidthRequest="110" />
                    
                    <Button Text="NÃO" 
                            Clicked="OnNaoClicked" 
                            BackgroundColor="Red" 
                            WidthRequest="110" />
                    
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
            
            <Button x:Name="BtnProxima" 
                    Text="Começar Teste" 
                    Clicked="OnGerarPalavraClicked" 
                    BackgroundColor="#2196F3" 
                    HeightRequest="50" />

            <Label x:Name="FeedbackLabel" FontSize="18" HorizontalOptions="Center" Margin="0,10" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="VOLTAR PARA HOME"
                Clicked="OnGoToHomeClicked"
                BackgroundColor="#512BD4"
                TextColor="White"
                HorizontalOptions="Fill"
                HeightRequest="55"
                CornerRadius="10"
                Margin="0,10,0,0" />
    </Grid>
</ContentPage>