<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.Testes.TesteReacao"
             BackgroundColor="#1A1A1A">

    <Grid RowDefinitions="Auto, *, Auto">

        <HorizontalStackLayout Grid.Row="0"
                               HorizontalOptions="Center"
                               Spacing="12"
                               Margin="0, 40, 0, 0">

            <Border WidthRequest="60" HeightRequest="80" BackgroundColor="#111111" StrokeThickness="2" Stroke="#333333">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.5"/>
                </Border.Shadow>

                <Border x:Name="Luz1" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="#444">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

            <Border WidthRequest="60" HeightRequest="80" BackgroundColor="#111111" StrokeThickness="2" Stroke="#333333">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.5"/>
                </Border.Shadow>

                <Border x:Name="Luz2" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="#444">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

            <Border WidthRequest="60" HeightRequest="80" BackgroundColor="#111111" StrokeThickness="2" Stroke="#333333">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.5"/>
                </Border.Shadow>

                <Border x:Name="Luz3" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="#444">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

            <Border WidthRequest="60" HeightRequest="80" BackgroundColor="#111111" StrokeThickness="2" Stroke="#333333">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.5"/>
                </Border.Shadow>

                <Border x:Name="Luz4" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="#444">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

            <Border WidthRequest="60" HeightRequest="80" BackgroundColor="#111111" StrokeThickness="2" Stroke="#333333">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="5" Opacity="0.5"/>
                </Border.Shadow>

                <Border x:Name="Luz5" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" StrokeThickness="0" BackgroundColor="#444">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

            <Label x:Name="lblResultado" 
                   Text="0 ms" 
                   TextColor="White"
                   FontSize="60" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center"/>

            <Button x:Name="btnAcao"
                    Text="Iniciar Corrida"
                    Clicked="OnActionButtonClicked"
                    WidthRequest="220"
                    HeightRequest="220"
                    CornerRadius="110"
                    BackgroundColor="#2ECC71"
                    TextColor="White"
                    FontSize="26"
                    FontAttributes="Bold">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="15" Opacity="0.6" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="10" Margin="0, 0, 0, 20">
            <Button Text="Ir para Home"
                    Clicked="OnGoToHomeClicked"
                    WidthRequest="180"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>
        </HorizontalStackLayout>

        <ImageButton x:Name="btnAjuda"
                     Grid.Row="1"
                     BackgroundColor="DeepSkyBlue"
                     CornerRadius="37"
                     WidthRequest="75"
                     HeightRequest="75"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0, 0, 20, 0" 
                     Clicked="OnHelpButtonClicked">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.5" />
            </ImageButton.Shadow>
        </ImageButton>

    </Grid>
</ContentPage>