<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.PT.Ajudas_para_testes.TesteReacaoAJUDA"
             Title="Tutorial de Ajuda">

    <Grid RowDefinitions="Auto, *, Auto" Padding="30">

        <Label 
            Grid.Row="0"
            Text="Tutorial de como Jogar"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,0,0,20"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="15">
            <Label Text="1. O objetivo é testar a tua reação." TextColor="White" FontSize="18"/>
            <Label Text="2. Clica no botão iniciar." TextColor="White" FontSize="18"/>
            <Label Text="3. Tenta parar o cronómetro no tempo alvo." TextColor="White" FontSize="18"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="2" Spacing="20" HorizontalOptions="Center" VerticalOptions="End" Margin="0,20,0,0">

            <Button Text="Voltar"
                    WidthRequest="150"
                    HeightRequest="60"
                    CornerRadius="10" 
                    BackgroundColor="DeepSkyBlue"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnVoltarClicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>