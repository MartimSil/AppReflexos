<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:testes="clr-namespace:REFTEST.Pages.PT.Testes"
             x:Class="REFTEST.Pages.PT.NotaTestes.TesteCoresNota"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Margin="0,0,0,15">
            <Label Text="Ranking de Cores" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#512BD4"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="listaNotas" Margin="0,0,0,10">
            <CollectionView.EmptyView>
                <Label Text="Ainda não há resultados." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="testes:RegistoCores">
                    <Border Margin="0,5" Padding="15" BackgroundColor="#F0F0F8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <SolidColorBrush Color="#512BD4"/>
                        </Border.Stroke>

                        <Grid ColumnDefinitions="*, *, Auto">
                            <Label Grid.Column="0" 
                                   Text="{Binding Nome}" 
                                   FontAttributes="Bold" 
                                   FontSize="18"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1" 
                                   Text="{Binding Regras, StringFormat='{0} Regras'}" 
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#2ECC71" 
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                            <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnApagarRegistroClicked" 
                                                          CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="&#215;" TextColor="Red" FontSize="26" FontAttributes="Bold" Padding="10"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Voltar"
                Clicked="OnGoToHomePageNotasClicked"
                HorizontalOptions="Center" 
                WidthRequest="180"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#512BD4"
                TextColor="White" />
    </Grid>
</ContentPage>