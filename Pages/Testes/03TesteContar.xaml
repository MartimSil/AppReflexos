<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.Testes.TesteContar">

    <Grid RowDefinitions="*, Auto, Auto">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="20">
            <Label x:Name="lblInstrucao" 
               Text="Clique quando chegar o numero X" 
               HorizontalOptions="Center" 
               FontSize="20"/>

            <Label x:Name="lblTempo" 
                   Text="00:00.00" 
                   FontSize="60" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
   
        </VerticalStackLayout>

        <HorizontalStackLayout 
            Grid.Row="1" Spacing="10" HorizontalOptions="Center" Margin="0,0,0,50">
            <Button x:Name="btnIniciarParar" Text="Iniciar" Clicked="OnIniciarPararClicked" BackgroundColor="Green" WidthRequest="100" />
            <Button Text="Zerar" Clicked="OnResetClicked" BackgroundColor="Gray" WidthRequest="100" />

        </HorizontalStackLayout>

        <Button Grid.Row="2"
                Text="Ir para Home"
                Clicked="OnGoToHomeClicked"
                HorizontalOptions="Center" 
                WidthRequest="180"
                HeightRequest="50"
                CornerRadius="25"
                Margin="0, 0, 0, 20"
                BackgroundColor="#512BD4"
                TextColor="White" />
    </Grid>
</ContentPage>