<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.DEF.Languages.PORT">

    <Grid RowDefinitions="*, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Button Text="Português" BackgroundColor="Green" MaximumWidthRequest="400" TextColor="#0E1A2A"/>

            <Button Text="Ingles" Clicked="OnGoToMainPageINGClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Voltar" Clicked="OnMainPageClicked" MaximumWidthRequest="400" TextColor="#0E1A2A"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>