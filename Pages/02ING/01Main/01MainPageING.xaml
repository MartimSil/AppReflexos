<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.ING.Main.MainPageING">

	<ScrollView>
		<VerticalStackLayout Padding="30,0" Spacing="25">

            <Label Text="RefTest ING"
                   HorizontalTextAlignment="Center"
                   FontSize="24"
                   FontAttributes="Bold" />

			<Label Text="Welcome to our app"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level1" />

			<Button Text="Ir para Home"
                    Clicked="OnGoToHomePageINGClicked"
                    SemanticProperties.HeadingLevel="Level1" />

            <Button Text="Settings" Clicked="OnGoToLanguagePageClicked" SemanticProperties.HeadingLevel="Level1"/>
        </VerticalStackLayout>
	</ScrollView>
</ContentPage>