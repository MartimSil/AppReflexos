<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.ING.Main.HomePageING">

    <Grid RowDefinitions="*, Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Button Text="Reaction Test" Clicked="OnTesteReacaoClicked"/>
            <Button Text="Vision Test" Clicked="OnTesteVisaoClicked"/>
            <Button Text="Blind Counting Test" Clicked="OnTesteContarClicked"/>
            <Button Text="Choice Test" Clicked="OnTesteEscolherClicked"/>
            <Button Text="Color Test" Clicked="OnTesteCoresClicked"/>
            <Button Text="Teste Master" Clicked="OnTesteReacaoMasterClicked"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Main" BackgroundColor="DeepSkyBlue" TextColor="White" Clicked="OnMainPageINGClicked" />
            <!--<Button Text="Status" BackgroundColor="DeepSkyBlue" Clicked="OnMenuClicked" />-->
            <!--<Button Text="Settings" BackgroundColor="DeepSkyBlue" Clicked="OnSettingsClicked" />-->
        </HorizontalStackLayout>

    </Grid>
</ContentPage>