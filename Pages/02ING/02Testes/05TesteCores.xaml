<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.ING.Testes.TesteCores"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="20" RowSpacing="15">

        <ImageButton x:Name="btnAjuda" Grid.Row="0" BackgroundColor="DeepSkyBlue" CornerRadius="37"
                     WidthRequest="70" HeightRequest="70" HorizontalOptions="End" Clicked="OnHelpButtonClicked">
            <ImageButton.Shadow>
                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.5" />
            </ImageButton.Shadow>
        </ImageButton>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="15">
            <Label x:Name="lblRegrasAtivas" Text="Rules: 0/10" TextColor="Gray" FontSize="18" HorizontalTextAlignment="Center"/>
            <Label x:Name="lblDescricaoRegra" Text="" TextColor="Gold" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" HeightRequest="30"/>
            <Label x:Name="lblFeedback" Text="Ready?" TextColor="White" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

            <Border x:Name="AlvoVisual" WidthRequest="180" HeightRequest="180" BackgroundColor="Transparent" StrokeThickness="2" Stroke="White" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle x:Name="FormaAlvo" CornerRadius="0"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlvoTapped" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" HorizontalOptions="Center">
            <Button x:Name="btnAcao" Text="Start" Clicked="OnActionButtonClicked" WidthRequest="200" HeightRequest="70" CornerRadius="35" BackgroundColor="#2ECC71" TextColor="White" FontSize="22" FontAttributes="Bold"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" VerticalOptions="End">
            <Button Text="Go Home" Clicked="OnGoToHomeClicked" WidthRequest="180" HeightRequest="50" CornerRadius="25" BackgroundColor="#512BD4" TextColor="White"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>