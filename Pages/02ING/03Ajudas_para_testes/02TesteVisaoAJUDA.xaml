<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="REFTEST.Pages.ING.Ajudas_para_testes.TesteVisaoAJUDA"
             Title="Test Vision HELP">

    <Grid RowDefinitions="Auto, *, Auto" Padding="30">

        <Label 
            Grid.Row="0"
            Text="Tutorial de como Jogar"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,0,0,20"/>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
        </VerticalStackLayout>

        <HorizontalStackLayout 
            Grid.Row="2"
            Spacing="20" 
            HorizontalOptions="Center" 
            VerticalOptions="End"
            Margin="0,20,0,0">

            <Button Text="Home"
                    WidthRequest="150"
                    HeightRequest="60"
                    CornerRadius="10" 
                    BackgroundColor="DeepSkyBlue"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnGoToHomeClicked" />

            <Button Text="Next"
                    WidthRequest="150"
                    HeightRequest="60"
                    CornerRadius="10"
                    BackgroundColor="MediumPurple"
                    TextColor="White"
                    FontSize="18"
                    Clicked="OnTesteVisaoClicked" />

        </HorizontalStackLayout>

    </Grid>
</ContentPage>